# ==============================================================================
# YOLO Cloud-Native Platform Environment Variables
# ==============================================================================

# Application Port
PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=development

# Database DSN (Data Source Name)
DB_DSN=postgres://postgres:postgres@localhost:5432/yolo?sslmode=disable

# Database Connection Pool Tuning
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m

# Prometheus Metric Scrape Configuration
METRICS_PORT=8080
METRICS_PATH=/metrics
